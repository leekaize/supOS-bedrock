{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask Orchestrator",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "orchestrator/app.py",
        "FLASK_ENV": "development"
      },
      "args": [
        "run",
        "--host=0.0.0.0",
        "--port=8080"
      ],
      "jinja": true,
      "console": "integratedTerminal"
    }
  ]
}
